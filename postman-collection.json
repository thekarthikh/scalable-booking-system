        {
          "name": "Cancel Booking",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{booking_base_url}}/api/v1/bookings/{{booking_id}}",
              "host": [
                "{{booking_base_url}}"
              ],
              "path": [
                "api",
