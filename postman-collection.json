      "key": "user_base_url",
      "value": "http://localhost:8081"
    },
    {
      "key": "booking_base_url",
      "value": "http://localhost:8082"
    },
    {
      "key": "inventory_base_url",
      "value": "http://localhost:8083"
    },
    {
      "key": "username",
      "value": "replace-me-user"
    },
    {
      "key": "email",
      "value": "replace-me@example.test"
    },
    {
      "key": "password",
      "value": "replace-me-password"
    },
    {
      "key": "jwt_token",
      "value": ""
    },
    {
      "key": "item_id",
      "value": "replace-with-inventory-id"
    },
    {
      "key": "booking_id",
      "value": ""
    },
    {
      "key": "idempotency_key",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "User Service",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{user_base_url}}/api/v1/auth/register",
              "host": [
                "{{user_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const jsonData = pm.response.json();",
                  "  pm.collectionVariables.set('jwt_token', jsonData.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{user_base_url}}/api/v1/auth/login",
              "host": [
                "{{user_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Inventory Service",
      "item": [
        {
          "name": "Get All Items",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{inventory_base_url}}/api/v1/inventory",
              "host": [
                "{{inventory_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "inventory"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Item",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{inventory_base_url}}/api/v1/inventory/{{item_id}}",
              "host": [
                "{{inventory_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "inventory",
                "{{item_id}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Booking Service",
      "item": [
        {
          "name": "Create Booking",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('idempotency_key')) {",
                  "  pm.collectionVariables.set('idempotency_key', pm.variables.replaceIn('{{$guid}}'));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const jsonData = pm.response.json();",
                  "  if (jsonData.id) pm.collectionVariables.set('booking_id', jsonData.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": \"{{item_id}}\",\n  \"quantity\": 1,\n  \"idempotencyKey\": \"{{idempotency_key}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{booking_base_url}}/api/v1/bookings",
              "host": [
                "{{booking_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get My Bookings",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{booking_base_url}}/api/v1/bookings",
              "host": [
                "{{booking_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Booking",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{booking_base_url}}/api/v1/bookings/{{booking_id}}",
              "host": [
                "{{booking_base_url}}"
              ],
              "path": [
                "api",
                "v1",
